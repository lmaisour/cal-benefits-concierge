# Copy this file to .env.local and fill in values from your Supabase project.
# Do not put real credentials in this example file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_PASSWORD=

# Server-only content pipeline (dry-run). Do not expose these to the browser.
# The dry-run endpoint stays disabled until both flags below are set in the
# server environment. AUTO_PUBLISH_ENABLED is unused and must remain false.
CONTENT_PIPELINE_ENABLED=false
CONTENT_PIPELINE_SECRET=
CONTENT_PIPELINE_DRAFT_PROVIDER=fake
AUTO_PUBLISH_ENABLED=false

# Optional OpenAI claim-selection provider. Production must stay on fake until
# the LLM milestone is explicitly enabled. Never prefix these with NEXT_PUBLIC_.
# CONTENT_PIPELINE_LLM_API_KEY=
# OPENAI_API_KEY=
# CONTENT_PIPELINE_LLM_MODEL=gpt-4o-mini
# CONTENT_PIPELINE_LLM_BASE_URL=https://api.openai.com/v1
# CONTENT_PIPELINE_LLM_TIMEOUT_MS=20000
# CONTENT_PIPELINE_LLM_MAX_OUTPUT_TOKENS=1200
# CONTENT_PIPELINE_LLM_MAX_RETRIES=2
