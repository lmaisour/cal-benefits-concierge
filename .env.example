# Copy this file to .env.local and fill in values from your Supabase project.
# Do not put real credentials in this example file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ADMIN_PASSWORD=

# Server-only content pipeline. Do not expose these to the browser.
# The dry-run endpoint stays disabled until both flags below are set in the
# server environment. AUTO_PUBLISH_ENABLED is unused and must remain false.
CONTENT_PIPELINE_ENABLED=false
CONTENT_PIPELINE_SECRET=
CONTENT_PIPELINE_DRAFT_PROVIDER=fake
CONTENT_PIPELINE_PUBLISH_ENABLED=false
AUTO_PUBLISH_ENABLED=false

# Server-only autonomous orchestrator. Default OFF.
# Autonomous publication requires ALL of:
#   CONTENT_AUTOMATION_ENABLED=true
#   CONTENT_AUTOMATION_PUBLISH_ENABLED=true
#   CONTENT_PIPELINE_PUBLISH_ENABLED=true
#   CONTENT_PIPELINE_DRAFT_PROVIDER=openai
# with a valid server-side API key. There is no provider fallback.
CONTENT_AUTOMATION_ENABLED=false
CONTENT_AUTOMATION_PUBLISH_ENABLED=false
CONTENT_AUTOMATION_SECRET=
# CONTENT_AUTOMATION_LEASE_SECONDS=180
# Vercel Cron bearer for GET /api/internal/content/automation/cron.
# Leave empty locally. Do not put a real value here.
CRON_SECRET=

# Optional OpenAI claim-selection provider. Never prefix these with NEXT_PUBLIC_.
# Production autonomous publication uses CONTENT_PIPELINE_DRAFT_PROVIDER=openai
# and fails closed if the key/config is missing. Do not put real keys here.
# CONTENT_PIPELINE_LLM_API_KEY=
# OPENAI_API_KEY=
# CONTENT_PIPELINE_LLM_MODEL=gpt-5.6-luna
# CONTENT_PIPELINE_LLM_BASE_URL=https://api.openai.com/v1
# CONTENT_PIPELINE_LLM_TIMEOUT_MS=20000
# CONTENT_PIPELINE_LLM_MAX_OUTPUT_TOKENS=1200
# CONTENT_PIPELINE_LLM_MAX_RETRIES=2
